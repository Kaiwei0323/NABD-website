# Copy this file to .env and fill in your values (never commit .env).
# cp .env.example .env   # macOS/Linux
# copy .env.example .env   # Windows CMD

# Required: NVIDIA AI Endpoints / build.nvidia.com API key
NVIDIA_API_KEY=nvapi-replace-with-your-key

# Optional: Hugging Face token for higher rate limits when downloading models
# HF_TOKEN=hf_replace-with-your-token
